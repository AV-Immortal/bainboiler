{
  "name": "bainboiler",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <=24.x.x",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/web",
    "apps/studio"
  ],
  "overrides": {
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "dev:studio": "npm run dev --workspace studio",
    "build:web": "npm run build --workspace web",
    "build:studio": "npm run build --workspace studio",
    "lint:web": "npm run lint --workspace web",
    "test:web": "npm run test --workspace web",
    "docker:build": "docker build -f Dockerfile.web -t bainboiler/web:latest . && docker build -f Dockerfile.studio -t bainboiler/studio:latest .",
    "docker:build:web": "docker build -f Dockerfile.web -t bainboiler/web:latest .",
    "docker:build:studio": "docker build -f Dockerfile.studio -t bainboiler/studio:latest .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps"
  },
  "dependencies": {},
  "devDependencies": {}
}
